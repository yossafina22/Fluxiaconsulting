# ====================================================================
# Fluxia Consulting — Variables d'environnement
# ====================================================================
# Copier ce fichier en .env.local pour le developpement local.
# Toutes les variables ci-dessous sont OPTIONNELLES : sans cle, le site
# tourne en mode demonstration honnete (log serveur, FAQ fallback, etc.)

# --- URL publique du site ---------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.fluxia-consulting.company

# --- LLM chatbot (optionnel) ------------------------------------------
# Sans cle, le chatbot repond via la FAQ uniquement (mode demo).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Email (optionnel) ------------------------------------------------
# Sans cle, les demandes contact sont loguees cote serveur mais pas envoyees.
# Signer up : https://resend.com
RESEND_API_KEY=
CONTACT_TO_EMAIL=fluxia@fluxia-consulting.company
CONTACT_FROM_EMAIL=

# --- Rate limiting Upstash (optionnel) --------------------------------
# Sans config, un limiteur in-memory LRU est utilise (reset au redemarrage).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Assistant vocal ElevenLabs (optionnel) ---------------------------
# Identifiant public de l'agent cree dans le dashboard ElevenLabs.
# Sans cette variable, le bouton vocal est masque.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
